# Normalize line endings for text files and make diffs portable.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Binary assets
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
